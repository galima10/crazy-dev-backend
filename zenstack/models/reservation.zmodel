import "journey"
import "account"

model Reservation {
  id        String   @id @default(uuid())
  journeyId String   @map("journey_id")
  reservedById String   @map("reserved_by_id")

  journey   Journey  @relation(fields: [journeyId], references: [id])
  reservedBy   Account  @relation(fields: [reservedById], references: [id])

  createdAt DateTime @default(now()) @db.DateTime(0) @map("created_at")

  @@unique([journeyId, reservedById])
}